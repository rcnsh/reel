{
  "name": "reel",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "A deterministic WebGL video engine and CLI for agents: scenes in TypeScript and three.js, rendered by headless Chrome into ffmpeg at any size and frame rate.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcnsh/reel.git"
  },
  "bugs": "https://github.com/rcnsh/reel/issues",
  "homepage": "https://github.com/rcnsh/reel#readme",
  "keywords": [
    "video",
    "webgl",
    "three.js",
    "motion-graphics",
    "headless-chrome",
    "ffmpeg",
    "mcp",
    "agents",
    "bun"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/fontkit": "^2.0.9",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@puppeteer/browsers": "^3.2.7",
    "fontkit": "2.0.4",
    "highlight.js": "11.11.1",
    "lottie-web": "5.13.0",
    "mp4box": "2.3.0",
    "opentype.js": "^2.0.0",
    "pngjs": "7.0.0",
    "three": "^0.186.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "bun cli/reel.ts dev --project examples/demo",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "bin": {
    "reel": "./cli/reel.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./scenes/*": "./src/scenes/*.ts"
  },
  "patchedDependencies": {
    "lottie-web@5.13.0": "patches/lottie-web@5.13.0.patch"
  }
}
