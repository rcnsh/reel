{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": [
      "vite/client",
      "bun"
    ],
    "paths": {
      "reel": [
        "./src/index.ts"
      ],
      "reel/config": [
        "./src/config.ts"
      ],
      "reel/scenes/*": [
        "./src/scenes/*"
      ],
      "@project/*": [
        "./examples/demo/*"
      ]
    }
  },
  "include": [
    "src",
    "cli",
    "tools",
    "examples",
    "tests"
  ]
}
